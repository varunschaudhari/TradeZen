NODE_ENV=development
PORT=5001

# Session signing key — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do not rotate casually in production, it invalidates every logged-in session.
JWT_SECRET=replace-with-a-random-64-char-hex-string

# MongoDB — use Atlas URI for production, localhost for local dev
MONGODB_URI=mongodb://localhost:27017/tradezen
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/tradezen?retryWrites=true&w=majority

# Claude AI — get from console.anthropic.com
ANTHROPIC_API_KEY=place-holder-for-your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6
# News sentiment (Gate 8): Claude scoring is on by default, on cheap Haiku.
# Set NEWS_USE_CLAUDE_SENTIMENT=false to fall back to keyword counting.
CLAUDE_SENTIMENT_MODEL=claude-haiku-4-5
NEWS_USE_CLAUDE_SENTIMENT=true

# Telegram — create bot via @BotFather, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password (not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_TO=recipient@gmail.com

# Services
PYTHON_SERVICE_URL=http://localhost:8001
CLIENT_URL=http://localhost:3001

# Trading defaults (used by db:seed script)
DEFAULT_CAPITAL=1000000
DEFAULT_RISK_PCT=1

# Scanner
SCAN_INTERVAL_MINUTES=45

# Rate limiting — global backstop only (Claude-touching routes have their own stricter
# claudeRateLimiter at 10/min, hardcoded; /health and /api/health are exempted entirely
# since useServiceHealth polls them every 30s from EVERY open tab regardless of page).
# Keep this generous: computed worst case with 4 heavy-polling tabs open at once
# (Dashboard + Positions + Intraday Trading + Risk) is ~480 req/15min; 3000 leaves
# headroom for 8-10 simultaneous tabs before this backstop should ever fire.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000

# Intraday ORB scanner (experimental, paper-tracked; alerts only, never orders).
# Set false to disable JOB 14/15 without redeploying code.
ORB_SCANNER_ENABLED=true

# Near-real-time quotes (Phase 3): NSE LTP via Yahoo's quote API, measured 2-6s lag vs
# yfinance's ~15 min. No broker account. Auto-falls back to yfinance on repeat failures.
LIVE_QUOTES_ENABLED=true
