          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trades/{{tradeId}}/target1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trades", "{{tradeId}}", "target1"]
            },
            "description": "Marks target1Hit=true, trails stopLoss to entryPrice (break-even), emits trade:target1 socket event, sends Telegram + email T1 alert. No request body needed."
          },
          "response": [
            {
              "name": "200 — T1 marked",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"success\":true,\"data\":{\"target1Hit\":true,\"slTrailed\":true,\"stopLoss\":2915.50},\"message\":\"Target 1 marked — SL trailed to entry\"}"
            }
          ]
        },
        {
          "name": "PATCH /api/trades/:id/close — close at target 2",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exitPrice\": 3148.00,\n  \"exitReason\": \"TARGET2\",\n  \"notes\": \"Full target achieved in 4 sessions\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/trades/{{tradeId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trades", "{{tradeId}}", "close"]
