              "raw": "{\n  \"exitPrice\": 2848.00,\n  \"exitReason\": \"STOP_LOSS\",\n  \"notes\": \"SL triggered — trend reversed\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/trades/{{tradeId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trades", "{{tradeId}}", "close"]
            },
            "description": "Close with a loss. realizedPnl will be negative."
          },
          "response": []
        }
